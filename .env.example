# Aetheria Weather Data Analysis System Configuration

# Flask Backend API
PORT=5001
FLASK_DEBUG=False
SECRET_KEY=aetheria-weather-secret-key-2026-prod

# MySQL Database Configuration
# If MySQL is not reachable or credentials are not supplied, the system
# seamlessly operates on a local embedded SQLite database for zero-friction setup.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=weather_analysis

# Frontend URL (for CORS)
VITE_API_BASE_URL=http://localhost:5001/api
